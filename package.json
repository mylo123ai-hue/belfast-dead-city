{
  "name": "belfast-dead-city",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --test",
    "test:browser": "npm run build && node tests/browser.smoke.mjs && node tests/benchmark.smoke.mjs && node tests/traversal.smoke.mjs && node tests/v5-benchmark.smoke.mjs",
    "test:v7": "npm run build && node tests/v7-residential.smoke.mjs",
    "test:v7-1": "npm run build && node tests/v7-1-stage.smoke.mjs",
    "record": "npm run build && node tests/record-gameplay.mjs",
    "record:benchmark": "npm run build && node tests/record-benchmark.mjs",
    "record:v5": "npm run build && node tests/record-v5-benchmark.mjs",
    "record:v7": "npm run build && node tests/record-v7-residential.mjs",
    "record:v7-1": "npm run build && node tests/record-v7-1-stage.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.7"
  }
}
